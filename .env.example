# Mainnet RPC endpoint used by the wallet ConnectionProvider.
# Used for fetching blockhashes, account info, IDLs, etc.
# Defaults to Solana's public mainnet-beta endpoint if unset, but that endpoint
# is heavily rate-limited and often returns 403s — set your own (Helius,
# QuickNode, Triton, Alchemy, etc.) for real use.
VITE_SOLANA_RPC_URL=https://your-rpc-provider.example.com/?api-key=YOUR_KEY
